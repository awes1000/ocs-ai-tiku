# ===== 服务配置 =====
# 监听端口
PORT=8060
# 监听地址（0.0.0.0 允许局域网/公网访问）
HOST=0.0.0.0
# SQLite 数据库路径（相对项目根目录）
DB_PATH=data/tiku.db

# ===== 初始管理员 =====
# 首次启动时若数据库中没有任何管理员，会用下面的账号创建
# 不填则自动生成随机用户名/密码并在控制台打印
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===== AI 配置兜底（也可在 WebGUI 里配置，WebGUI 优先）=====
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# responses | chat_completions
AI_API_TYPE=chat_completions
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=35000
# 可选：HTTP 代理，如 http://127.0.0.1:7890
AI_PROXY=

# ===== 搜题行为 =====
# 未配置 token 时是否允许匿名搜题
ALLOW_ANONYMOUS=false
